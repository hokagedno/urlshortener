HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

POSTGRES_DSN=postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=24h

BASE_URL=http://localhost:8080
CLICK_BUFFER_SIZE=1024
CLICK_WORKERS=4
CLICK_BATCH_SIZE=50
CLICK_FLUSH_EVERY=2s
RATE_LIMIT=60
RATE_WINDOW=1m
